{
  "name": "@tu-vi/core",
  "version": "1.0.0",
  "description": "Zi Wei Dou Shu (紫微斗数) core algorithm library — chart generation, Si Hua, pattern detection, classical texts",
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./ziwei": {
      "types": "./dist/ziwei/index.d.ts",
      "import": "./dist/ziwei/index.mjs",
      "require": "./dist/ziwei/index.js"
    },
    "./nihai": {
      "types": "./dist/nihai/index.d.ts",
      "import": "./dist/nihai/index.mjs",
      "require": "./dist/nihai/index.js"
    },
    "./classics": {
      "types": "./dist/classics/index.d.ts",
      "import": "./dist/classics/index.mjs",
      "require": "./dist/classics/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "iztro": "^2.5.8",
    "lunar-javascript": "^1.7.3"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  }
}
